{
  "name": "press-mentions",
  "version": "0.0.0",
  "private": true,
  "description": "Press-mentions monitoring for OurCrowd portfolio companies.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env src/server/index.js",
    "job:daily": "node --env-file=.env src/jobs/daily.js",
    "job:eval": "node --env-file=.env src/jobs/prompt-eval/index.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "dup": "jscpd --threshold 3 --mode strict --fail-on-empty --no-tips --reporters console src test",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run knip && npm run dup && npm run audit",
    "prepare": "husky",
    "job:backfill": "node --env-file=.env src/jobs/backfill.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "linkedom": "^0.18.13",
    "ollama": "^0.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/eslint-plugin-promise": "^7.3.0",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.0.0",
    "eslint-plugin-n": "^18.4.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jscpd": "^5.3.3",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
