# Copy this file to .env before running any npm script that loads it.
# Node loads it with --env-file. Paths are relative to the repository root.

# Coverage SQLite store. The job lock file sits next to it as <path>.lock.
COVERAGE_DB=coverage.sqlite

# Minimum milliseconds between two requests to news.google.com. Default 1000.
GOOGLE_TOKEN_MS=1000

# Evaluation SQLite store for classifier prompt scores.
EVAL_DB=data/evaluation.sqlite

# Local Ollama server.
OLLAMA_HOST=http://127.0.0.1:11434

# The live model and prompt version are constants in src/core/classifier.js.
# Edit LIVE_MODEL and LIVE_PROMPT_VERSION by hand. They are not environment variables.
