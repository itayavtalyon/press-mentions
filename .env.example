# Copy this file to .env before running any npm script that loads it.
# Node loads it with --env-file. Paths are relative to the repository root.

# Coverage SQLite store. Each command's lock file sits next to it as <path>.<command>.lock.
COVERAGE_DB=data/coverage.sqlite

# Minimum milliseconds between two requests to news.google.com. Default 1000.
GOOGLE_TOKEN_MS=1000

# Minimum milliseconds between two requests to any other host. Default 2000.
PUBLISHER_TOKEN_MS=2000

# Alerts SQLite store: subscriptions, notified rows, and the outbox. Default data/alerts.sqlite.
ALERTS_DB=data/alerts.sqlite

# Default subscriber. The digest upserts one subscription per company. Stored as typed.
ALERT_EMAIL=alerts@example.com

# Evaluation SQLite store for classifier prompt scores.
EVAL_DB=data/evaluation.sqlite

# Dashboard port on 127.0.0.1. Default 3000. A set value must be a whole number from 1 to 65535.
# PORT=3000

# Local Ollama server.
OLLAMA_HOST=http://127.0.0.1:11434

# The live model and prompt version are constants in src/core/classifier.js.
# Edit LIVE_MODEL and LIVE_PROMPT_VERSION by hand. They are not environment variables.
